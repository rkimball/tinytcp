{
    "build": {
        "dockerfile": "../Dockerfile",
        "context": "../..",
        "args": {
            "USER_UID": "1000",
            "USER_GID": "1000"
        }
    },
    "updateRemoteUserUID": true,
    "workspaceMount": "source=${localWorkspaceFolder},target=/home/dev/tinytcp,type=bind",
    "workspaceFolder": "/home/dev/tinytcp",
    "mounts": [
        "source=${localEnv:HOME}/.claude,target=/home/dev/.claude,type=bind"
    ],
    "containerEnv": {
        "HOST_WORKSPACE_FOLDER": "${localWorkspaceFolder}",
        "CLAUDE_CONFIG_DIR": "/home/dev/.claude"
    },
    "postCreateCommand": "bash .devcontainer/ClaudeSupport/postCreate.sh",
    "runArgs": ["--cap-add=NET_ADMIN"],
    "forwardPorts": [8080],
    "remoteUser": "dev",
    "containerUser": "dev",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools",
                "ms-vscode.cmake-tools",
                "ms-vscode.cmake-tools-helper",
                "ms-vscode.remote-containers",
                "johnpapa.vscode-peacock",
                "github.copilot",
                "github.copilot-chat",
                "anthropic.claude-code"
            ]
        }
    }
}
